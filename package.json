{
  "name": "mf2actual",
  "version": "0.1.0",
  "private": false,
  "description": "Sync Moneyforward ME transactions into Actual Budget (via mfme-cli)",
  "bin": {
    "mf2actual": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "install-bin": "BIN=\"${MF2ACTUAL_BIN_DIR:-$HOME/.local/bin}\"; mkdir -p \"$BIN\" && chmod +x src/cli.ts && ln -sfn \"$PWD/src/cli.ts\" \"$BIN/mf2actual\" && echo \"installed: $BIN/mf2actual -> $PWD/src/cli.ts\"",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test": "bun test"
  },
  "dependencies": {
    "@actual-app/api": "26.8.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.6.0",
    "bun": ">=1.1.0"
  }
}
